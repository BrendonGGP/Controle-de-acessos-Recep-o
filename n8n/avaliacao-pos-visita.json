    {
      "parameters": {
        "jsCode": "\nfunction render(tpl, vars) {\n  return String(tpl || '').replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (m, k) =>\n    k in vars ? String(vars[k]) : m\n  );\n}\nfunction normalizePhone(v) {\n  let d = String(v || '').replace(/\\D/g, '');\n  if (d.length === 12 || d.length === 13) {\n    if (!d.startsWith('55')) return null;\n    d = d.substring(2);\n  }\n  if (d.length !== 10 && d.length !== 11) return null;\n  if (parseInt(d.substring(0, 2), 10) < 11) return null;\n  if (d.length === 11 && d[2] !== '9') return null;\n  return '55' + d;\n}\n\n// Devolver lista vazia travaria o fluxo: o n8n nao roda os nos seguintes,\n// o webhook responderia vazio e a Edge Function leria como erro. O marcador\n// segue ate o Resumo, que o traduz numa resposta honesta.\nfunction semEnvio(motivo) {\n  return [{ json: { semDestinatario: true, motivo } }];\n}\n\nconst visitas = $('Buscar Visita').all().map(i => i.json).filter(r => r && r.id);\nconst visita = visitas[0];\nif (!visita) { return semEnvio('Visita nao encontrada'); }\n\n// So visita/reuniao e atendimento recebem avaliacao. A tela ja filtra, mas\n// o webhook e publico atras do token: a regra tambem vale aqui.\nconst ELEGIVEIS = ['visitas_reunioes', 'atendimento'];\nif (!ELEGIVEIS.includes(visita.category)) {\n  return semEnvio('Categoria nao recebe avaliacao: ' + visita.category);\n}\n\n// Reenvio do mesmo link por uma segunda baixa seria insistencia.\nif (visita.avaliacao_enviada_em) {\n  return semEnvio('Avaliacao ja enviada em ' + visita.avaliacao_enviada_em);\n}\n\nconst fone = normalizePhone(visita.phone);\nif (!fone) { return semEnvio('Visitante sem telefone valido'); }\n\nconst linkRow = $('Buscar Link').all().map(i => i.json).find(r => r && r.value);\nconst link = linkRow?.value;\nif (!link) { return semEnvio('Link de avaliacao nao configurado'); }\n\nconst tplRow = $('Buscar Template').all().map(i => i.json).find(r => r && r.message);\nconst tpl = tplRow?.message\n  || 'Ola *{{nome_visitante}}*! \\u{1f44b}\\n\\nObrigado pela sua visita ao *Grupo Gomes Pires*.\\n\\nSua opiniao nos ajuda a melhorar:\\n\\n{{link}}';\n\nreturn [{ json: {\n  number: fone,\n  text: render(tpl, { nome_visitante: visita.visitor_name, link }),\n}}];\n"
      },
