      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\n// Le o marcador na origem, nao no no de envio: o HTTP substitui o json do\n// item pela resposta da Evolution, entao o semDestinatario nao sobrevive\n// ate aqui. Foi assim que o \"aviso nao saiu\" falso apareceu antes.\nconst origem = $('Montar Avaliacao').all();\nconst semNinguem = origem.length === 1 && origem[0].json.semDestinatario;\n\nif (semNinguem) {\n  // `marcar: false` impede o PATCH adiante de registrar como avaliada uma\n  // visita que nunca recebeu nada — e o item segue, em vez de uma lista\n  // vazia que travaria o fluxo e deixaria o webhook sem resposta.\n  return [{ json: { success: true, enviado: false, marcar: false, motivo: origem[0].json.motivo } }];\n}\n\n// A Evolution devolve key.id quando aceitou a mensagem. Sem ele, o envio\n// falhou — e dizer que saiu seria mentir para a recepcao.\nconst resposta = $input.first().json;\nconst aceitou = Boolean(resposta?.key?.id);\n\nreturn [{ json: {\n  success: aceitou,\n  enviado: aceitou,\n  marcar: aceitou,\n  ...(aceitou ? {} : { motivo: 'Evolution nao confirmou o envio' }),\n} }];\n"
      },
      "id": "resumo",
      "name": "Resumo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
