    {
      "parameters": {
        "jsCode": "\n// O no anterior e o PATCH, cuja resposta nao interessa. Quem tem o\n// veredito e o Resumo — e o webhook responde o ultimo no, que e este.\nconst r = $('Resumo').first().json;\nreturn [{ json: {\n  success: r.success,\n  enviado: r.enviado,\n  ...(r.motivo ? { motivo: r.motivo } : {}),\n} }];\n"
      },
