        200,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "\n// Quem recebeu o link ha mais de 24h e ainda nao recebeu lembrete.\n// So o limite superior: nao ha piso porque a busca ja exclui quem ja tem\n// lembrete, e uma visita antiga que escapou (fluxo fora do ar, por exemplo)\n// deve receber assim que der, nao ficar orfa para sempre.\nconst limite = new Date(Date.now() - 24 * 60 * 60 * 1000).toISOString();\nreturn [{ json: { limite } }];\n"
      },
      "id": "janela",
      "name": "Janela de 24h",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://afsjoaizrzmbbzquajbe.supabase.co/rest/v1/access_logs?select=id,visitor_name,phone,avaliacao_enviada_em&avaliacao_enviada_em=not.is.null&avaliacao_lembrete_em=is.null&avaliacao_enviada_em=lt.' + $json.limite }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "sb_publishable_dmxqufD4FuZgESEXKBrbaA_Utuza9J3"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Login Supabase').first().json.access_token }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "buscar-pendentes",
      "name": "Buscar Pendentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://afsjoaizrzmbbzquajbe.supabase.co/rest/v1/message_templates?select=message&type=eq.avaliacao&category=eq.lembrete' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "sb_publishable_dmxqufD4FuZgESEXKBrbaA_Utuza9J3"
            },
            {
              "name": "Authorization",
