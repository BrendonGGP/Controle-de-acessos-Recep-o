    {
      "parameters": {
        "jsCode": "\nfunction render(tpl, vars) {\n  return String(tpl || '').replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (m, k) =>\n    k in vars ? String(vars[k]) : m\n  );\n}\nfunction normalizePhone(v) {\n  let d = String(v || '').replace(/\\D/g, '');\n  if (d.length === 12 || d.length === 13) {\n    if (!d.startsWith('55')) return null;\n    d = d.substring(2);\n  }\n  if (d.length !== 10 && d.length !== 11) return null;\n  if (parseInt(d.substring(0, 2), 10) < 11) return null;\n  if (d.length === 11 && d[2] !== '9') return null;\n  return '55' + d;\n}\n\nconst body = $('Webhook').first().json.body;\nconst c = $('Buscar Colaborador').all().map(i => i.json).find(r => r && r.name);\nif (!c) { throw new Error('Colaborador nao encontrado'); }\n\nconst fone = normalizePhone(c.phone);\nif (!fone) { throw new Error('Telefone invalido: ' + c.phone); }\n\nconst tpls = $('Buscar Template').all().map(i => i.json).filter(r => r && r.message);\nconst especifico = tpls.find(t => t.category === body.category);\nconst generico = tpls.find(t => t.category === null);\nconst tpl = (especifico || generico)?.message\n  || 'Ola *{{nome_colaborador}}*! 🏢\\n\\nO(a) visitante *{{nome_visitante}}* registrou uma *{{acao}}* na recepcao.';\n\nreturn [{ json: {\n  number: fone,\n  text: render(tpl, {\n    nome_colaborador: c.name,\n    nome_visitante: body.visitor_name,\n    acao: body.action,\n  }),\n}}];\n"
      },
