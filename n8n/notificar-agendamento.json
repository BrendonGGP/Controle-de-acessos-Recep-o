      "id": "buscar-template",
      "name": "Buscar Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "\nfunction render(tpl, vars) {\n  return String(tpl || '').replace(/\\{\\{\\s*(\\w+)\\s*\\}\\}/g, (m, k) =>\n    k in vars ? String(vars[k]) : m\n  );\n}\nfunction normalizePhone(v) {\n  let d = String(v || '').replace(/\\D/g, '');\n  if (d.length === 12 || d.length === 13) {\n    if (!d.startsWith('55')) return null;\n    d = d.substring(2);\n  }\n  if (d.length !== 10 && d.length !== 11) return null;\n  if (parseInt(d.substring(0, 2), 10) < 11) return null;\n  if (d.length === 11 && d[2] !== '9') return null;\n  return '55' + d;\n}\n\nconst rows = $('Buscar Reserva').all().map(i => i.json).filter(r => r && r.id);\nconst booking = rows[0];\nif (!booking) { return [{ json: { erro: 'Reserva nao encontrada', enviar: [] } }]; }\n\nconst tplRow = $('Buscar Template').all().map(i => i.json).find(r => r && r.message);\nconst tpl = tplRow?.message\n  || 'Ola *{{nome_colaborador}}*! 📅\\n\\nVoce foi convidado(a) para uma reuniao:\\n\\n*Assunto:* {{titulo}}\\n*Sala:* {{sala}}\\n*Data:* {{data}}\\n*Horario:* {{horario}}';\n\nconst sala = booking.rooms?.name || 'Sala';\nconst data = String(booking.booking_date).split('-').reverse().join('/');\nconst horario = String(booking.start_time).substring(0,5) + ' as ' + String(booking.end_time).substring(0,5);\n\nconst out = [];\nfor (const p of (booking.booking_participants || [])) {\n  const c = p.collaborators;\n  if (!c) continue;\n  const fone = normalizePhone(c.phone);\n  if (!fone) continue;\n  out.push({ json: {\n    number: fone,\n    text: render(tpl, {\n      nome_colaborador: c.name,\n      titulo: booking.title,\n      sala, data, horario,\n    }),\n  }});\n}\nreturn out;\n"
      },
      "id": "montar-mensagens",
